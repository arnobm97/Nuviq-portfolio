# Email delivery for the contact form API route (app/api/contact/route.ts)
# Uses Nodemailer with SMTP. Fill these in with your provider's details
# (e.g. SendGrid SMTP, Postmark, Resend SMTP, Gmail app password, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=hello@nuviq.ai
CONTACT_FROM_EMAIL=noreply@nuviq.ai

# Optional analytics
NEXT_PUBLIC_GA_ID=

# Site URL (used for metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.nuviq.ai
